{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/**", "destination": "/admin/index.html" },
    { "source": "/seguimiento", "destination": "/seguimiento/index.html" },
    { "source": "/seguimiento/**", "destination": "/seguimiento/index.html" }
  ],
  "headers": [
    { "source": "**/*.usdz", "headers": [{ "key": "Content-Type", "value": "model/vnd.usdz+zip" }] }
  ]
}
